rules_version = '2';

// Firebase Console → Firestore Database → Rules дээр энэийг ХУУЛЖ оруулаад Publish хийнэ.
// Вэб админ одоо Firebase Auth ашиглахгүй тул хөгжүүлэлтэд доорх нээлттэй дүрмүүд шаардлагатай.
// PRODUCTION-д заавал Auth + нөхцөлтэй дүрмээр солино!

service cloud.firestore {
  match /databases/{database}/documents {

    match /parking_spots/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /payments/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{id} {
      allow read: if true;
      allow write: if true;
    }
  }
}
